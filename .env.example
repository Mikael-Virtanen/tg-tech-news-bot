# Local runs only. On GitHub, put the SECRETS under Settings > Secrets and variables > Actions > Secrets
# and the optional settings under ... > Variables. Never commit a real .env file.

# --- Secrets ---
GEMINI_API_KEY=            # free, no card: https://aistudio.google.com/apikey
TELEGRAM_BOT_TOKEN=        # from @BotFather
TELEGRAM_CHAT_ID=          # @your_channel_username (public channel) or the numeric id (-100...)
TELEGRAPH_ACCESS_TOKEN=    # python -m src.publishing.telegraph "ShortName" "Channel name" "https://t.me/your_channel"
# GITHUB_TOKEN=            # optional locally; Actions provides it. Raises GitHub API limits for README fetching

# --- Optional settings (defaults in src/config.py) ---
PUBLISH_MODE=single        # single = post each item as soon as it is processed (default) | digest = one daily message
# ITEMS_PER_SOURCE=2       # new items processed per source per run (the Gemini free quota is the real limit)
# MAX_POSTS_PER_RUN=6
# WRITE_ARTICLES=true      # also write the full Persian article on Telegraph
# SOURCES=hackernews,github,arxiv
# HN_MIN_POINTS=100
# ARXIV_KEYWORDS=LLM,agent,reasoning,RAG,transformer   # default; ARXIV_KEYWORDS=none = every paper (too many)
# ARXIV_CATEGORIES=cs.AI,cs.CL,cs.LG
# DIGEST_SIZE=10
# DIGEST_MAX_AGE_HOURS=48
# CHANNEL_HANDLE=@your_channel         # shown in every post's footer
# TELEGRAPH_AUTHOR_NAME=
# TELEGRAPH_AUTHOR_URL=
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_BASE_URL=          # proxy/gateway base URL (e.g. https://sinoxapi.com/v1); empty = Google's
                            # /v1beta endpoint. Custom base: both x-goog-api-key and Bearer headers are sent.
# GEMINI_THINKING_LEVEL=   # set to "low" if you switch to a model that thinks by default (e.g. gemini-3.8-flash)
# STATE_DIR=.state
# DRY_RUN=false
# BOT_USER_AGENT=TechNewsBot/1.0 (+https://t.me/your_channel)
